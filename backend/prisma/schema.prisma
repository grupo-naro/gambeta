generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ADMIN
  RECEPCIONISTA
}

enum EstadoReserva {
  CONFIRMADA
  ESPERANDO_SENA
  CANCELADA
  COMPLETADA
}

enum EstadoPago {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum VerificadoPor {
  IA
  HUMANO
}

enum EstadoSuscripcion {
  ACTIVA
  CANCELADA
}

model CanchaGrupo {
  id       String   @id @default(cuid())
  nombre   String
  creadoEn DateTime @default(now())
  canchas  Cancha[]
}

model Sector {
  id          String          @id @default(cuid())
  nombre      String
  canchas     CanchaSector[]
  ocupaciones ReservaSector[]
}

model CanchaSector {
  canchaId String
  sectorId String
  cancha   Cancha @relation(fields: [canchaId], references: [id], onDelete: Cascade)
  sector   Sector @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@id([canchaId, sectorId])
}

model ReservaSector {
  id          String        @id @default(cuid())
  reservaId   String
  reserva     Reserva       @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  sectorId    String
  sector      Sector        @relation(fields: [sectorId], references: [id])
  estado      EstadoReserva
  fechaInicio DateTime      @db.Timestamptz(3)
  fechaFin    DateTime      @db.Timestamptz(3)

  @@index([sectorId])
}

model Cancha {
  id             String              @id @default(cuid())
  nombre         String
  tipo           String
  jugadores      Int                 @default(5)
  destacada      Boolean             @default(false)
  precioHora     Decimal             @db.Decimal(10, 2)
  precioHoraPico Decimal             @default(0) @db.Decimal(10, 2)
  /// Precio propio por duración, por banda. Opcionales: si faltan, el precio de esa duración
  /// se deriva proporcionalmente de precioHora/precioHoraPico, como siempre.
  /// La decisión es POR DURACIÓN: una cancha puede tener precio120 y no precio90.
  precio90       Decimal?            @db.Decimal(10, 2)
  precio90Pico   Decimal?            @db.Decimal(10, 2)
  precio120      Decimal?            @db.Decimal(10, 2)
  precio120Pico  Decimal?            @db.Decimal(10, 2)
  senaMonto      Decimal?            @db.Decimal(10, 2)
  activa         Boolean             @default(true)
  creadoEn       DateTime            @default(now())
  grupoId        String?
  grupo          CanchaGrupo?        @relation(fields: [grupoId], references: [id])
  esEntera       Boolean             @default(false)
  sectores       CanchaSector[]
  reservas       Reserva[]
  horarios       HorarioDisponible[]
  turnosFijos    TurnoFijo[]
  bloqueos       Bloqueo[]

  @@index([activa])
}

model TurnoFijo {
  id            String               @id @default(cuid())
  canchaId      String
  cancha        Cancha               @relation(fields: [canchaId], references: [id])
  clienteNombre String
  whatsapp      String?
  diaSemana     Int
  horaInicio    String
  horaFin       String
  /// OBSOLETO: no lo usa nadie para cobrar. `materializar` toma el precio de la cancha.
  /// Se conserva porque la lista del panel todavía lo muestra. Para el abono existe `montoAbono`.
  precio        Decimal?             @db.Decimal(10, 2)
  /// Abono: período pagado y su monto. Los tres van juntos o ninguno. Si están, los turnos
  /// de este fijo se materializan en $0. El período NO corta la generación: vencido, el fijo
  /// sigue generando turnos y solo se enciende un aviso en el panel.
  vigenciaDesde DateTime?            @db.Date
  vigenciaHasta DateTime?            @db.Date
  montoAbono    Decimal?             @db.Decimal(10, 2)
  activo        Boolean              @default(true)
  creadoEn      DateTime             @default(now())
  excepciones   TurnoFijoExcepcion[]
  reservas      Reserva[]
  cobros        Cobro[]

  @@index([canchaId, diaSemana])
}

model TurnoFijoExcepcion {
  id          String    @id @default(cuid())
  turnoFijoId String
  turnoFijo   TurnoFijo @relation(fields: [turnoFijoId], references: [id], onDelete: Cascade)
  fecha       DateTime  @db.Date

  @@unique([turnoFijoId, fecha])
}

enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
}

enum MotivoBloqueo {
  TORNEO
  ENTRENAMIENTO
  MANTENIMIENTO
  OTRO
}

model Bloqueo {
  id          String             @id @default(cuid())
  canchaId    String
  cancha      Cancha             @relation(fields: [canchaId], references: [id])
  excepciones BloqueoExcepcion[]
  motivo      MotivoBloqueo
  recurrente  Boolean            @default(false)
  diaSemana   Int?
  fecha       DateTime?          @db.Date
  horaInicio  String
  horaFin     String
  nota        String?
  activo      Boolean            @default(true)
  creadoEn    DateTime           @default(now())

  @@index([canchaId])
}

model BloqueoExcepcion {
  id        String   @id @default(cuid())
  bloqueoId String
  bloqueo   Bloqueo  @relation(fields: [bloqueoId], references: [id], onDelete: Cascade)
  fecha     DateTime @db.Date

  @@unique([bloqueoId, fecha])
}

model HorarioDisponible {
  id         String  @id @default(cuid())
  canchaId   String
  cancha     Cancha  @relation(fields: [canchaId], references: [id], onDelete: Cascade)
  diaSemana  Int
  horaInicio String
  horaFin    String
  activo     Boolean @default(true)

  @@index([canchaId, diaSemana])
}

model Cliente {
  id               String        @id @default(cuid())
  nombre           String
  whatsapp         String        @unique
  esContacto       Boolean       @default(false)
  nombreConfirmado Boolean       @default(false)
  confiable        Boolean       @default(false)
  primeraReserva   DateTime?
  totalReservas    Int           @default(0)
  creadoEn         DateTime      @default(now())
  reservas         Reserva[]
  suscripciones    Suscripcion[]
}

model Reserva {
  id            String          @id @default(cuid())
  canchaId      String
  cancha        Cancha          @relation(fields: [canchaId], references: [id])
  clienteId     String
  cliente       Cliente         @relation(fields: [clienteId], references: [id])
  fechaInicio   DateTime        @db.Timestamptz(3)
  fechaFin      DateTime        @db.Timestamptz(3)
  estado        EstadoReserva
  esContacto    Boolean
  monto         Decimal         @db.Decimal(10, 2)
  montoSena     Decimal?        @db.Decimal(10, 2)
  notas         String?
  turnoFijoId   String?
  turnoFijo     TurnoFijo?      @relation(fields: [turnoFijoId], references: [id])
  suscripcionId String?
  suscripcion   Suscripcion?    @relation(fields: [suscripcionId], references: [id])
  montoLista    Decimal?        @db.Decimal(10, 2)
  creadoEn      DateTime        @default(now())
  pago          Pago?
  sectores      ReservaSector[]
  cobros        Cobro[]

  @@unique([turnoFijoId, fechaInicio])
  @@index([canchaId, fechaInicio])
  @@index([clienteId])
  @@index([estado])
  @@index([suscripcionId])
}

model Pago {
  id             String         @id @default(cuid())
  reservaId      String         @unique
  reserva        Reserva        @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  montoDetectado Decimal?       @db.Decimal(10, 2)
  comprobanteUrl String?
  mpPreferenceId String?
  mpPaymentId    String?
  verificadoPor  VerificadoPor?
  aprobadoPorId  String?
  aprobadoPor    AdminUser?     @relation(fields: [aprobadoPorId], references: [id])
  estado         EstadoPago     @default(PENDIENTE)
  creadoEn       DateTime       @default(now())
}

model AdminUser {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String
  nombre        String
  rol           Rol           @default(RECEPCIONISTA)
  esDefault     Boolean       @default(false)
  creadoEn      DateTime      @default(now())
  expiraEn      DateTime?
  pagos         Pago[]
  auditLogs     AuditLog[]
  cobros        Cobro[]
  suscripciones Suscripcion[]
}

model AuditLog {
  id          String     @id @default(cuid())
  adminId     String?
  admin       AdminUser? @relation(fields: [adminId], references: [id])
  accion      String
  entidad     String
  entidadId   String?
  payload     Json?
  descripcion String     @default("")
  creadoEn    DateTime   @default(now())

  @@index([entidad, entidadId])
  @@index([creadoEn])
}

enum SenaModo {
  PORCENTAJE
  FIJO
}

model Configuracion {
  id                String   @id @default("default")
  horaApertura      String   @default("16:00")
  horaCierre        String   @default("23:00")
  horaAperturaFinde String   @default("16:00")
  horaCierreFinde   String   @default("00:00")
  picoDesde         String   @default("")
  picoHasta         String   @default("")
  picoFindeDesde    String   @default("")
  picoFindeHasta    String   @default("")
  adminWhatsapp     String   @default("")
  senaModo          SenaModo @default(PORCENTAJE)
  senaPorcentaje    Int      @default(50)
  senaMontoFijo     Decimal  @default(5000) @db.Decimal(10, 2)
  cbu               String   @default("")
  alias             String   @default("")
  titular           String   @default("")
  cbu2              String   @default("")
  alias2            String   @default("")
  titular2          String   @default("")
  buffetPinHash     String   @default("")
  actualizadoEn     DateTime @updatedAt
}

/// Fila única (id "default"): la cuenta de Mercado Pago del complejo, vinculada por OAuth.
/// Los tokens se guardan cifrados con AES-256-GCM (ver src/utils/cripto.ts).
model MercadoPagoCuenta {
  id            String   @id @default("default")
  accessToken   String
  refreshToken  String
  venceEn       DateTime
  mpUserId      String
  apodo         String   @default("")
  /// true cuando la renovación falló: el panel lo muestra en rojo y hay que revincular.
  caida         Boolean  @default(false)
  vinculadaEn   DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

model Cobro {
  id              String       @id @default(cuid())
  reservaId       String?
  reserva         Reserva?     @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  suscripcionId   String?
  suscripcion     Suscripcion? @relation(fields: [suscripcionId], references: [id], onDelete: Restrict)
  turnoFijoId     String?
  turnoFijo       TurnoFijo?   @relation(fields: [turnoFijoId], references: [id], onDelete: Restrict)
  monto           Decimal      @db.Decimal(10, 2)
  medio           MedioPago
  origen          String       @default("MANUAL")
  registradoPorId String?
  registradoPor   AdminUser?   @relation(fields: [registradoPorId], references: [id])
  creadoEn        DateTime     @default(now())

  @@index([creadoEn])
  @@index([reservaId])
  @@index([suscripcionId])
  @@index([turnoFijoId])
}

enum EstadoCajaBuffet {
  ABIERTA
  CERRADA
}

model ProductoBuffet {
  id               String                  @id @default(cuid())
  nombre           String
  codigoBarra      String?                 @unique
  precio           Decimal                 @db.Decimal(10, 2)
  stock            Int                     @default(0)
  stockMinimo      Int                     @default(0)
  enBotonera       Boolean                 @default(false)
  orden            Int                     @default(0)
  activo           Boolean                 @default(true)
  ventas           VentaBuffet[]
  stockMostradores StockMostrador[]
  entregas         EntregaMostradorLinea[]
}

enum TipoMostrador {
  PRINCIPAL
  SECUNDARIO
}

/// Un puesto de atención del buffet. Cada uno tiene su propio PIN: es lo que permite
/// saber QUIÉN vendió, y sin eso la conciliación del cierre es imposible.
model Mostrador {
  id       String             @id @default(cuid())
  nombre   String
  tipo     TipoMostrador
  pinHash  String             @default("")
  activo   Boolean            @default(true)
  cajas    CajaBuffet[]
  stock    StockMostrador[]
  entregas EntregaMostrador[]

  /// Un solo mostrador de cada tipo. El diseño es para dos puestos, no N.
  @@unique([tipo])
}

model CajaBuffet {
  id               String             @id @default(cuid())
  abiertaEn        DateTime           @default(now())
  cerradaEn        DateTime?
  estado           EstadoCajaBuffet   @default(ABIERTA)
  totalUnidades    Int?
  totalMonto       Decimal?           @db.Decimal(10, 2)
  mostradorId      String
  mostrador        Mostrador          @relation(fields: [mostradorId], references: [id])
  tickets          TicketBuffet[]
  entregasRendidas EntregaMostrador[]

  @@index([mostradorId])
}

/// Cuánto tiene asignado un mostrador de cada producto. Solo lo usa el SECUNDARIO: el stock
/// del principal es `ProductoBuffet.stock`, que no se migra para no tocar a sus consumidores
/// (panel, alerta de stock bajo, planilla de Google).
model StockMostrador {
  mostradorId String
  mostrador   Mostrador      @relation(fields: [mostradorId], references: [id])
  productoId  String
  producto    ProductoBuffet @relation(fields: [productoId], references: [id])
  cantidad    Int            @default(0)

  @@id([mostradorId, productoId])
}

/// Una entrega del principal al secundario: el "cuánto le di".
model EntregaMostrador {
  id                 String                  @id @default(cuid())
  mostradorId        String
  mostrador          Mostrador               @relation(fields: [mostradorId], references: [id])
  creadaEn           DateTime                @default(now())
  /// En qué cierre se rindió esta entrega. `null` = todavía pendiente de conciliar.
  ///
  /// Es lo que define el "entregado" de un cierre, y a propósito NO se usa un rango de fechas
  /// contra la apertura de la caja: en la vida real el principal entrega mercadería ANTES de
  /// que el secundario abra su caja, y esa entrega quedaría fuera de la ventana. Con esta
  /// marca, el orden de los hechos deja de importar.
  conciliadaEnCajaId String?
  conciliadaEnCaja   CajaBuffet?             @relation(fields: [conciliadaEnCajaId], references: [id])
  lineas             EntregaMostradorLinea[]

  @@index([mostradorId, conciliadaEnCajaId])
}

model EntregaMostradorLinea {
  id         String           @id @default(cuid())
  entregaId  String
  entrega    EntregaMostrador @relation(fields: [entregaId], references: [id], onDelete: Cascade)
  productoId String
  producto   ProductoBuffet   @relation(fields: [productoId], references: [id])
  cantidad   Int
}

model TicketBuffet {
  id          String        @id @default(cuid())
  uid         String        @unique
  cajaId      String
  caja        CajaBuffet    @relation(fields: [cajaId], references: [id])
  total       Decimal       @db.Decimal(10, 2)
  medioPago   MedioPago
  montoPagado Decimal       @db.Decimal(10, 2)
  vuelto      Decimal       @db.Decimal(10, 2)
  creadoEn    DateTime      @default(now())
  lineas      VentaBuffet[]

  @@index([cajaId])
}

model VentaBuffet {
  id         String         @id @default(cuid())
  ticketId   String
  ticket     TicketBuffet   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  productoId String
  producto   ProductoBuffet @relation(fields: [productoId], references: [id])
  precioUnit Decimal        @db.Decimal(10, 2)
  cantidad   Int            @default(1)
  creadoEn   DateTime       @default(now())

  @@index([ticketId])
}

model Suscripcion {
  id          String            @id @default(cuid())
  clienteId   String
  cliente     Cliente           @relation(fields: [clienteId], references: [id])
  inicio      DateTime          @db.Date
  vencimiento DateTime          @db.Date
  estado      EstadoSuscripcion @default(ACTIVA)
  precio      Decimal?          @db.Decimal(10, 2)
  nota        String?
  creadoPorId String?
  creadoPor   AdminUser?        @relation(fields: [creadoPorId], references: [id])
  creadoEn    DateTime          @default(now())
  reservas    Reserva[]
  cobros      Cobro[]

  @@index([clienteId, vencimiento])
  @@index([estado, vencimiento])
}
