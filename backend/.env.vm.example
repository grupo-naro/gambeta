# Copiar a .env en la VM (en la carpeta backend/) y completar.
# PG_USER / PG_PASSWORD = credenciales del Postgres EXISTENTE de la VM
# (obtenerlas con: docker exec postgres env | grep POSTGRES_)
PG_USER=canchitas
PG_PASSWORD=changeme
JWT_SECRET=poné-un-secreto-de-32-caracteres-minimo-aca
SERVICE_API_KEY=poné-una-api-key-para-n8n-aca
ADMIN_SEED_EMAIL=admin@gambeteando.com
ADMIN_SEED_PASSWORD=cambiame

SENA_MODO=porcentaje
SENA_PORCENTAJE=50
SENA_MONTO_FIJO=5000
SENA_CBU=
SENA_ALIAS=
SENA_TITULAR=

# Mercado Pago — vinculación OAuth de la cuenta del complejo desde el panel.
# MP_CLIENT_ID y MP_CLIENT_SECRET son los del aplicativo de Mercado Pago (developers.mercadopago.com).
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Clave de 32 bytes en base64 para cifrar (AES-256-GCM) los tokens de la cuenta vinculada
# antes de guardarlos en la base. Generarla con: openssl rand -base64 32
MP_ENCRYPTION_KEY=
# Clave secreta que da Mercado Pago al crear el webhook. Sin esto el webhook
# rechaza toda notificación con 401 y las señas nunca se aprueban solas.
MP_WEBHOOK_SECRET=
# URLs públicas, SIN barra final.
RESERVAS_PUBLIC_URL=https://reservas-gambeta.gruponaro.com.ar
BACKEND_PUBLIC_URL=https://api-gambeta.gruponaro.com.ar
# PANEL_PUBLIC_URL arma el redirect_uri del OAuth de Mercado Pago (a dónde vuelve el admin
# después de autorizar la vinculación).
#
# OJO: el redirect_uri que se arma acá (PANEL_PUBLIC_URL + /configuracion/mercadopago/callback)
# tiene que coincidir CARÁCTER POR CARÁCTER con el registrado en la aplicación de Mercado Pago.
# Si algún día cambia el dominio del panel, hay que actualizar los DOS lados a la vez o el
# botón de vincular deja de funcionar. Una cuenta ya vinculada sigue cobrando igual: el
# redirect_uri solo se usa al autorizar, la renovación del token no lo toca.
PANEL_PUBLIC_URL=https://panel-gambeta.gruponaro.com.ar
