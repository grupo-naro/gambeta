# Copiar a .env en la VM (en la carpeta backend/) y completar.
# PG_USER / PG_PASSWORD = credenciales del Postgres EXISTENTE de la VM
# (obtenerlas con: docker exec postgres env | grep POSTGRES_)
PG_USER=canchitas
PG_PASSWORD=changeme
JWT_SECRET=poné-un-secreto-de-32-caracteres-minimo-aca
SERVICE_API_KEY=poné-una-api-key-para-n8n-aca
ADMIN_SEED_EMAIL=admin@canchitas.com
ADMIN_SEED_PASSWORD=cambiame

SENA_MODO=porcentaje
SENA_PORCENTAJE=50
SENA_MONTO_FIJO=5000
SENA_CBU=
SENA_ALIAS=
SENA_TITULAR=

# Mercado Pago — cobro de la seña desde la web de reservas.
# Las cuatro son obligatorias para que funcione el link de pago; si falta
# alguna el backend arranca igual y recién falla al crear la preferencia.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# URLs públicas, SIN barra final.
RESERVAS_PUBLIC_URL=https://reservar-canchas.gruponaro.com.ar
BACKEND_PUBLIC_URL=https://api-canchas.gruponaro.com.ar
