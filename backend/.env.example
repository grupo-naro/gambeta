DATABASE_URL=postgresql://canchitas:canchitas@localhost:5432/canchitas?schema=public
JWT_SECRET=change-me-32-chars-minimum-secret
JWT_EXPIRES_IN=12h
SERVICE_API_KEY=change-me-service-key
BUFFET_API_KEY=change-me-buffet-key
TZ_NEGOCIO=America/Argentina/Buenos_Aires
CANCELACION_ANTICIPACION_MINUTOS=10
SENA_TIMEOUT_MINUTOS=30
ADMIN_SEED_EMAIL=admin@gambeteando.com
ADMIN_SEED_PASSWORD=change-me-admin
PORT=3000

SENA_MODO=porcentaje
SENA_PORCENTAJE=50
SENA_MONTO_FIJO=5000
SENA_CBU=
SENA_ALIAS=
SENA_TITULAR=

# Evolution (WhatsApp) — para el aviso automático de seña aprobada.
# Deben ser los MISMOS valores que usa el bot en n8n.
EVOLUTION_URL=http://evolution:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Mercado Pago — cobro de la seña desde la web de reservas.
# Si falta cualquiera de las dos primeras, crear la preferencia falla con
# "Mercado Pago no está configurado" y la reserva queda sin link de pago.
MP_ACCESS_TOKEN=
# Clave secreta que da Mercado Pago al crear el webhook. Sin esto el webhook
# rechaza toda notificación con 401 y las señas nunca se aprueban solas.
MP_WEBHOOK_SECRET=
# URLs públicas, SIN barra final.
# RESERVAS_PUBLIC_URL arma las back_urls del checkout (a dónde vuelve el cliente).
RESERVAS_PUBLIC_URL=
# BACKEND_PUBLIC_URL arma el notification_url (dónde MP avisa el pago).
BACKEND_PUBLIC_URL=
