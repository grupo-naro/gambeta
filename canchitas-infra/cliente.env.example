# Configuración por cliente/complejo.
# bootstrap.sh reemplaza estos valores en los workflows de n8n antes de importarlos
# (los JSON de workflows/ tienen placeholders __ASI__).

# Nombre del complejo (el bot se presenta con este nombre)
NOMBRE_COMPLEJO="Mi Complejo"

# Nombre de la instancia de WhatsApp en Evolution (una por complejo)
EVOLUTION_INSTANCE=micomplejo-whap

# API key con la que los workflows llaman a Evolution.
# Usar el mismo valor que AUTHENTICATION_API_KEY en evolution/.env.
EVOLUTION_API_KEY=CHANGE_ME

# API key con la que los workflows llaman al backend (SERVICE_API_KEY del backend)
SERVICE_API_KEY=CHANGE_ME

# Token secreto del webhook Evolution -> n8n (inventar uno largo y aleatorio)
WEBHOOK_TOKEN=CHANGE_ME

# Google Gemini (transcripción de audios y cerebro del bot)
GEMINI_API_KEY=CHANGE_ME

# Admin del panel (mismas credenciales que ADMIN_SEED_* del backend)
ADMIN_EMAIL=admin@micomplejo.com
ADMIN_PASSWORD=CHANGE_ME

# WhatsApp del dueño/admin del complejo (recibe avisos del bot), sin "+"
ADMIN_WHATSAPP=549XXXXXXXXXX

# Email que recibe los mails de error de los workflows
ALERT_EMAIL=alertas@micomplejo.com
