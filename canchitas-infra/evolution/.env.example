# --- URL pública del servidor (IP o dominio del VPS) ---
SERVER_URL=http://CHANGE_ME_IP:8082

# --- Base de datos (usuario/password = los de postgres/.env) ---
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://canchitas_user:CHANGE_ME@postgres:5432/evolution_db
DATABASE_CONNECTION_CLIENT_NAME=evolution
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true

# --- Redis (password = el de redis/.env) ---
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://:CHANGE_ME@redis:6379
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false

# --- Auth: API key global de esta instalación de Evolution ---
AUTHENTICATION_TYPE=apikey
AUTHENTICATION_API_KEY=CHANGE_ME
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true

# --- WhatsApp / QR ---
QRCODE_LIMIT=30
QRCODE_COLOR=#198754
CONFIG_SESSION_PHONE_CLIENT=Evolution API
CONFIG_SESSION_PHONE_NAME=Chrome
CONFIG_SESSION_PHONE_VERSION=2.3000.1023204200

# --- Logs ---
LOG_LEVEL=ERROR,WARN,DEBUG,INFO,LOG,VERBOSE
LOG_COLOR=true
LOG_BAILEYS=debug

# --- Misc ---
DOCKER_ENV=true
DEL_INSTANCE=false
LANGUAGE=pt-BR
